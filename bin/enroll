#!/usr/bin/env bash
# enroll — put one repo under the shared Dependabot standards.
#
#   bin/enroll <owner/repo> [--ci-check <job id> | --external-check <context>]
#                           [--security-only] [--dry-run]
#
# THREE SHAPES, because Kevin's repos are not all the same animal:
#
#   full            --ci-check <job id>
#                   Version-update pull requests arrive, and merge behind a CI job this
#                   repo's own workflows declare.
#
#   security-only   --security-only --external-check <context>
#                   No dependabot.yml is written, so only GitHub's account-wide SECURITY
#                   fixes arrive — and they merge behind a check some OTHER service
#                   reports (a Vercel or Cloudflare build), because the repo has no CI
#                   workflow of its own. About 29 of Kevin's repos are this shape.
#
#   security-only   --security-only
#   with no gate    No dependabot.yml and no required check: security fixes arrive and
#                   wait for a human, labelled `no-ci-gate`. Nothing merges by itself.
#
# What it does, in the order it does it:
#   1. creates the four labels the shared workflow uses (create-or-update, always safe)
#   2. looks at the repo's files and works out which package ecosystems it has
#      (skipped entirely with --security-only — nothing is composed from the answer)
#   3. writes .github/dependabot.yml — ONLY if the repo does not already have one, and
#      never at all with --security-only
#   4. writes .github/workflows/dependabot-automerge.yml, the ten-line pointer stub
#      (replacing an older inline copy of the merge rules if it finds one)
#   5. opens a PULL REQUEST with those changes. It never pushes to the default branch.
#   6. turns on the repo's "allow auto-merge" setting
#   7. with --ci-check or --external-check, creates/updates a ruleset called `standards-ci`
#      on the default branch requiring that check — with repository admins allowed to
#      bypass, so Kevin can still push straight to main, while the bot must satisfy it.
#
# Running it twice does nothing the second time. That is the point: it is safe to re-run
# over every repo whenever the standards change.
#
# Written 2026-09-11; --security-only and --external-check added 2026-09-14.
# Needs: gh (authenticated), jq, git, python3.

set -euo pipefail

STD_REPO="khglynn/repo-standards"
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TEMPLATES="$HERE/templates"
BRANCH_NAME="standards/enroll"
# One string, used twice: to write the commit and to recognise our own past commit before
# overwriting the branch. If these two ever drift apart, every re-run refuses to push.
COMMIT_SUBJECT="standards: enroll in shared Dependabot auto-merge"

DRY_RUN=false
CI_CHECK=""
EXTERNAL_CHECK=""
SECURITY_ONLY=false
# The one context string the ruleset will require, whichever flag supplied it. Every line
# below the argument parsing reads this rather than re-asking which flag was used, so the
# ruleset step cannot drift apart from the validation step.
REQUIRED_CHECK=""
CHECK_KIND=""
TARGET=""
FILES_PROPOSED=""

die()  { echo "error: $*" >&2; exit 1; }
say()  { echo "$*"; }
step() { echo; echo "── $*"; }

# ---------------------------------------------------------------------------- args
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run)  DRY_RUN=true; shift ;;
    --ci-check) CI_CHECK="${2:-}"; [ -n "$CI_CHECK" ] || die "--ci-check needs a check name"; shift 2 ;;
    --external-check) EXTERNAL_CHECK="${2:-}"; [ -n "$EXTERNAL_CHECK" ] || die "--external-check needs a context name"; shift 2 ;;
    --security-only)  SECURITY_ONLY=true; shift ;;
    # The header block itself, not a hard-coded line range: the range was '2,20p' and the
    # moment this header grew (2026-09-14) the help truncated mid-sentence, silently.
    -h|--help)  awk 'NR==1 {next} /^#/ {sub(/^# ?/, ""); print; next} {exit}' "${BASH_SOURCE[0]}"; exit 0 ;;
    -*)         die "unknown option: $1" ;;
    *)          [ -z "$TARGET" ] || die "give exactly one owner/repo"; TARGET="$1"; shift ;;
  esac
done
[ -n "$TARGET" ] || die "usage: bin/enroll <owner/repo> [--ci-check <check>] [--dry-run]"
case "$TARGET" in */*) : ;; *) die "repo must be owner/repo, got '$TARGET'" ;; esac
for t in gh jq git python3; do command -v "$t" >/dev/null || die "missing required tool: $t"; done

# The two check flags are validated against completely different evidence — a job id
# against the repo's own workflow files, an external context against what has actually been
# reported on its recent pull requests — and the ruleset can only require one context. Two
# flags would mean silently honouring one and dropping the other.
if [ -n "$CI_CHECK" ] && [ -n "$EXTERNAL_CHECK" ]; then
  die "--ci-check and --external-check are mutually exclusive: the first is a job id from
       this repo's own workflows, the second a context some other service reports. Pick
       the one that will actually go green on a pull request here."
fi
# A multi-line context is refused rather than mangled: `grep -F` treats each line of its
# pattern as a SEPARATE alternative, so "Vercel<newline>anything" would "match" a history
# containing only `Vercel`, and the ruleset would then be handed the whole literal string —
# a gate nothing reports, validated by a check that thought it had proof (Codex review,
# 2026-09-14). No real status context contains a newline.
for spelling in "$CI_CHECK" "$EXTERNAL_CHECK"; do
  case "$spelling" in
    # $'\n', not "$(printf '\n')" — command substitution strips trailing newlines, so the
    # latter is the EMPTY string and the pattern `**` matches everything, including "".
    # Caught by testing the guard rather than trusting it, 2026-09-14.
    *$'\n'*) die "a check name cannot contain a newline. Got: $(printf '%q' "$spelling")" ;;
  esac
done
if [ -n "$CI_CHECK" ]; then
  REQUIRED_CHECK="$CI_CHECK"; CHECK_KIND="job"
elif [ -n "$EXTERNAL_CHECK" ]; then
  REQUIRED_CHECK="$EXTERNAL_CHECK"; CHECK_KIND="external"
fi

if $DRY_RUN; then say "DRY RUN — nothing below is actually written."; fi
say "Enrolling $TARGET"
if $SECURITY_ONLY; then
  say "   --security-only: no dependabot.yml will be written, so this repo gets GitHub's"
  say "   account-wide SECURITY fixes and no routine version-update pull requests."
fi

# --------------------------------------------------------------------- repo basics
# The REST view, not `gh repo view` — `allow_auto_merge` is only exposed here.
repo_json=$(gh api "repos/$TARGET" 2>/dev/null) \
  || die "cannot read $TARGET (does it exist, and are you logged in as its owner?)"
DEFAULT_BRANCH=$(printf '%s' "$repo_json" | jq -r '.default_branch')
[ "$(printf '%s' "$repo_json" | jq -r '.archived')" = "false" ] || die "$TARGET is archived — nothing to enroll"
# A fork's dependency config belongs to whoever we forked from; enrolling one means fighting
# upstream on every sync. Refuse by default rather than quietly creating that conflict.
if [ "$(printf '%s' "$repo_json" | jq -r '.fork')" = "true" ] && [ "${ALLOW_FORK:-}" != "1" ]; then
  die "$TARGET is a FORK. Its dependabot.yml is upstream's, and enrolling it means a merge
       conflict on every sync. If you really mean to, re-run with ALLOW_FORK=1."
fi
VISIBILITY=$(printf '%s' "$repo_json" | jq -r '.visibility')
AUTO_MERGE_ALREADY=$(printf '%s' "$repo_json" | jq -r '.allow_auto_merge')
say "   default branch: $DEFAULT_BRANCH   visibility: $VISIBILITY"

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT

# -------------------------------------------- 1. LOOK BEFORE WRITING ANYTHING AT ALL
#
# Every refusal below says "nothing on $TARGET was changed", and until 2026-09-14 that was
# false: the labels step ran first, so a bad check name or an unenrollable repo was turned
# away AFTER five `gh label create --force` calls had created or overwritten labels on it
# (Codex review). Validation now genuinely comes first. The clone is local and writes
# nothing to GitHub, so doing it here costs only a few seconds on the paths that refuse.
step "Checks"
CLONE="$WORK/repo"
git clone --quiet --depth 1 --branch "$DEFAULT_BRANCH" "https://github.com/$TARGET.git" "$CLONE" \
  || die "could not clone $TARGET"
mkdir -p "$CLONE/.github/workflows"

# Which dependabot.yml, if any, this repo already has. Read here rather than in the Files
# step because --security-only's refusal depends on it and has to happen before any write.
existing_db=""
# Explicit `if`, not `[ -f x ] && y=z`: this is the LAST command in the loop body, and under
# `set -e` a false test there makes the whole loop exit non-zero and kills the script.
for cand in "$CLONE/.github/dependabot.yml" "$CLONE/.github/dependabot.yaml"; do
  if [ -f "$cand" ]; then existing_db="$cand"; fi
done

# A pre-existing dependabot.yml makes --security-only's promise FALSE: routine version
# bumps would keep arriving and, with a gate in place, merging themselves — while the run
# that enabled that said in its summary that only security fixes would. Refuse rather than
# print a sentence the repo contradicts.
if $SECURITY_ONLY && [ -n "$existing_db" ]; then
  die "--security-only, but $TARGET already has ${existing_db#"$CLONE"/} — so version-update
       pull requests will keep arriving no matter what this run does, and the summary would
       tell you otherwise. Drop --security-only, or delete that file first.
       Nothing on $TARGET was changed."
fi

# ---- validate --ci-check ----------------------------------------------------------
#
# ⚠ A required status check is a free-text CONTEXT: GitHub happily accepts one that
# nothing will ever report. A typo — `check` for `checks` — creates a gate that can never
# go green: Kevin bypasses it as an admin and never notices, while every Dependabot PR
# queues auto-merge and hangs forever. That is precisely the silent failure this whole
# system exists to prevent, so the name is checked against the job ids the repo's own
# workflows actually declare. (Added 2026-09-11.)
if [ -n "$CI_CHECK" ]; then
  jobs_found=$(python3 "$HERE/bin/lib/pr-job-ids.py" "$CLONE")
  if [ -z "$jobs_found" ]; then
    die "--ci-check '$CI_CHECK' cannot be verified: $TARGET has no workflow that runs on
       pull_request, so no check will ever report on a PR. Add CI first, then enroll.
       Nothing on $TARGET was changed."
  fi
  # `<<<` and `--`, both fixes from the 2026-09-14 review of the sibling check below.
  # The old form was `printf … | cut -f1 | grep -qxF "$CI_CHECK"`, which had two faults:
  # `grep -q` exits on its first match, so under `pipefail` the upstream can die of SIGPIPE
  # and the pipeline reports 141 — a VALID name read as a miss, and only once the job list
  # is big enough not to fit a pipe buffer; and without `--`, a name beginning with a dash
  # is parsed as a grep option, so `-echecks` would "match" and then be written into the
  # ruleset as the literal string `-echecks`, which nothing reports.
  if ! grep -qxF -- "$CI_CHECK" <<< "$(cut -f1 <<< "$jobs_found")"; then
    say "   jobs this repo actually runs on pull requests:"
    printf '%s\n' "$jobs_found" | awk -F'\t' '{printf "      %-24s (%s, shown as \"%s\")\n", $1, $2, $3}'
    die "--ci-check '$CI_CHECK' is not one of them. A required check that nothing reports
       is a gate that can never go green — every Dependabot PR would queue and hang
       forever. Pick a job id from the list above. Nothing on $TARGET was changed."
  fi
  say "   CI check '$CI_CHECK' is a real job that runs on pull requests here ✓"
fi

# ---- validate --external-check the only way an external check CAN be validated --------
#
# ⚠ Same trap as --ci-check, one step further out, and it needs different evidence. An
# external context is reported by a third-party app — Vercel, Cloudflare Pages — so no file
# in this repo declares it and `pr-job-ids.py` can never see it. A typo would create exactly
# the gate that can never go green which the check above exists to prevent.
#
# The only honest proof is history: has anything ACTUALLY reported this context on a pull
# request here? Five most recent pull requests, ANY state — a repo whose Dependabot PRs all
# merged has no open ones to learn from — and both surfaces a check can arrive on. GitHub's
# required-status-check rule matches a commit status context and a check-run name by the
# same string, so either one counts as proof.
#
# ⚠ AND WHOSE PULL REQUESTS THEY WERE IS PART OF THE EVIDENCE (Codex review, 2026-09-14).
# A check that reports on a human's pull request proves nothing about Dependabot's: a
# workflow triggered only on `feature/**`, or a Vercel project that ignores bot branches,
# would pass a naive name match and then never report on the branches that actually matter.
# So the author of every sampled pull request is read too, and the three cases are kept
# apart: proved on a Dependabot PR (the real thing), proved only on human PRs with no
# Dependabot PR in the sample to judge by (accepted, loudly), and proved on human PRs while
# Dependabot's own PRs went ungated (refused — that is positive evidence of the bad case).
if [ -n "$EXTERNAL_CHECK" ]; then
  say "   verifying '$EXTERNAL_CHECK' against this repo's five most recent pull requests…"
  prs=$(gh api "repos/$TARGET/pulls?state=all&sort=created&direction=desc&per_page=5" \
          --jq '.[] | [(.number|tostring), .head.sha, (.user.login // "?")] | @tsv' 2>/dev/null) \
    || die "could not list $TARGET's pull requests, so '$EXTERNAL_CHECK' could not be
       verified against anything. Nothing on $TARGET was changed."
  if [ -z "$prs" ]; then
    die "--external-check '$EXTERNAL_CHECK' cannot be verified: $TARGET has no pull
       requests at all, so nothing has ever reported a check on one here. Open a pull
       request, let the build run once, then enroll. Nothing on $TARGET was changed."
  fi

  proof=""
  bot_proof=""
  bot_seen=0
  heads_total=0
  heads_read=0
  heads_unread=""
  heads_partial=""
  : > "$WORK/contexts-seen.txt"
  while IFS=$'\t' read -r pr_num head_sha pr_author; do
    [ -n "$head_sha" ] || continue
    heads_total=$((heads_total + 1))
    case "$pr_author" in dependabot*) is_bot=yes; bot_seen=$((bot_seen + 1)) ;; *) is_bot=no ;; esac

    # A HEAD THAT COULD NOT BE READ IS NOT A HEAD WITH NO CHECKS. A merged PR's branch is
    # often deleted, and swallowing an unreadable head makes it look exactly like a clean
    # one — the refusal below would then print a short list of "what IS reported" that is
    # short because nobody looked.
    #
    # ⚠ AND THE OBVIOUS PROBE DOES NOT WORK. The combined-status endpoint
    # `commits/{sha}/status` answers **200** for a commit that does not exist in the repo at
    # all, with `{"state":"pending","statuses":[],"total_count":0}` — measured against
    # khglynn/ynai with an all-zeroes SHA, 2026-09-14. So its exit status can never tell "no
    # statuses" from "no such commit", and a script that trusts it reports a confident empty
    # answer about a commit it never found. `commits/{sha}/check-runs` DOES 404 on the same
    # SHA and returns 200 with an empty array for a real commit that has none, so it is the
    # honest reachability probe — and it is a call this loop already makes.
    #
    # `--paginate` on both: each defaults to 30 results, and declaring a context absent from
    # a truncated read is the same sin one page down (Codex review).
    #
    # </dev/null on every call inside this loop: a command that reads stdin would eat the
    # here-string feeding `read` and end the loop early, having checked one PR.
    if runs=$(gh api --paginate "repos/$TARGET/commits/$head_sha/check-runs?per_page=100" \
                --jq '.check_runs[].name' </dev/null 2>/dev/null); then
      heads_read=$((heads_read + 1))
      if statuses=$(gh api --paginate "repos/$TARGET/commits/$head_sha/status?per_page=100" \
                      --jq '.statuses[].context' </dev/null 2>/dev/null); then :; else
        statuses=""; heads_partial="$heads_partial #$pr_num"
      fi
    else
      runs=""; statuses=""
      heads_unread="$heads_unread #$pr_num"
    fi

    if [ -n "$statuses" ]; then awk -v k='commit status' '{print $0 "\t" k}' <<< "$statuses" >> "$WORK/contexts-seen.txt"; fi
    if [ -n "$runs" ];     then awk -v k='check run'     '{print $0 "\t" k}' <<< "$runs"     >> "$WORK/contexts-seen.txt"; fi

    # Here-strings, not pipes, and `--` before the pattern. `grep -q` exits on its first
    # match and under `pipefail` the printf feeding it dies of SIGPIPE, so a pipeline
    # reports 141 and a real match reads as a miss. And without `--`, a context beginning
    # with a dash is read as a grep option: `--external-check -eVercel` "matched" a history
    # containing only `Vercel`, and the ruleset would then have required the literal string
    # `-eVercel`, which nothing reports (Codex review, reproduced 2026-09-14).
    hit=""
    if grep -qxF -- "$EXTERNAL_CHECK" <<< "$statuses"; then
      hit="PR #$pr_num by $pr_author (as a commit status)"
    elif grep -qxF -- "$EXTERNAL_CHECK" <<< "$runs"; then
      hit="PR #$pr_num by $pr_author (as a check run)"
    fi
    if [ -n "$hit" ]; then
      [ -n "$proof" ] || proof="$hit"
      if [ "$is_bot" = "yes" ] && [ -z "$bot_proof" ]; then bot_proof="$hit"; fi
    fi
  done <<< "$prs"

  if [ -n "$heads_unread" ]; then
    say "   note: $heads_read of $heads_total pull-request heads could be read; no answer for$heads_unread"
    say "   (a merged branch's head commit is often gone — unreadable, which is not the same"
    say "   as carrying no checks, so nothing was inferred from those)"
  fi
  if [ -n "$heads_partial" ]; then
    say "   note: the commit-status list could not be read for$heads_partial, so only their"
    say "   check runs were considered."
  fi

  if [ -z "$proof" ]; then
    if [ "$heads_read" -eq 0 ]; then
      die "--external-check '$EXTERNAL_CHECK' could not be verified either way: none of
       $TARGET's $heads_total most recent pull-request heads could be read, so this is an
       absence of evidence and not evidence of absence. Nothing on $TARGET was changed."
    fi
    say "   checks that HAVE been reported on those pull requests:"
    if [ -s "$WORK/contexts-seen.txt" ]; then
      sort -u "$WORK/contexts-seen.txt" | awk -F'\t' '{printf "      %-44s (%s)\n", $1, $2}'
    else
      say "      (none at all — nothing has reported any check on a pull request here)"
    fi
    die "--external-check '$EXTERNAL_CHECK' is not one of them. A required check that
       nothing reports is a gate that can never go green — every Dependabot PR would
       queue for auto-merge and hang forever. Pick a name from the list above, exactly
       as it is spelled. Nothing on $TARGET was changed."
  fi

  if [ -n "$bot_proof" ]; then
    say "   external check '$EXTERNAL_CHECK' reports on Dependabot's own pull requests ✓ — $bot_proof"
  elif [ "$bot_seen" -gt 0 ]; then
    say "   '$EXTERNAL_CHECK' was reported on $proof,"
    say "   but NOT on any of the $bot_seen Dependabot pull request(s) in the same sample."
    die "that is the failure this flag exists to prevent, seen directly: the check runs on
       people's branches and not on Dependabot's, so every update PR would queue behind a
       gate that never reports. Fix the integration to build Dependabot's branches (in
       Vercel: Git → ignored build step / branch settings), then re-run.
       Nothing on $TARGET was changed."
  else
    say "   external check '$EXTERNAL_CHECK' has really been reported here ✓ — $proof"
    say "   ⚠ but none of those $heads_total pull requests was Dependabot's, so nothing here"
    say "     proves the check reports on a dependabot/* branch. Watch the first security PR."
  fi
  say "   ⚠ it is reported by a third-party app, not by a file in this repo. If that"
  say "     integration is ever removed or stops building this repo's branches, the gate"
  say "     goes silent and update PRs will queue forever rather than fail loudly."
fi

# ---- what does this branch ALREADY require? -----------------------------------------
#
# ⚠ An empty $REQUIRED_CHECK means "this invocation named no check", NOT "this branch has
# none" (Codex review, 2026-09-14). A repo can already carry a ruleset or classic
# protection, and the shared workflow reads the branch, not this script's arguments — so
# `--security-only` with no check flag used to promise in its PR body and summary that
# every security fix would wait for a human, on a repo where they would in fact merge
# themselves. Read the branch and say what is true. Rulesets first (readable without admin),
# classic as the fallback, exactly as bin/audit and the shared workflow do it.
BRANCH_ESC=${DEFAULT_BRANCH//\//%2F}
EXISTING_CHECKS=""
CHECKS_KNOWN=no
if rules_json=$(gh api "repos/$TARGET/rules/branches/$BRANCH_ESC" 2>/dev/null); then
  CHECKS_KNOWN=yes
  EXISTING_CHECKS=$(printf '%s' "$rules_json" | jq -r '[.[] | select(.type=="required_status_checks")
      | .parameters.required_status_checks[]?.context] | unique | join(", ")' 2>/dev/null || true)
fi
if [ -z "$EXISTING_CHECKS" ]; then
  if prot_json=$(gh api "repos/$TARGET/branches/$BRANCH_ESC/protection" 2>/dev/null); then
    CHECKS_KNOWN=yes
    EXISTING_CHECKS=$(printf '%s' "$prot_json" | jq -r '(((.required_status_checks.checks // []) | map(.context))
        + (.required_status_checks.contexts // [])) | unique | join(", ")' 2>/dev/null || true)
  fi
fi
# GATE_STATE is what the PR body and the summary speak from, so they can never describe a
# gate this run did not look at: `new` (we are about to require one), `preexisting` (none
# given, the branch already has one), `none` (none given, the branch really has none),
# `unknown` (none given and neither endpoint answered).
if [ -n "$REQUIRED_CHECK" ]; then
  GATE_STATE=new
elif [ -n "$EXISTING_CHECKS" ]; then
  GATE_STATE=preexisting
  say "   no check flag given, but $DEFAULT_BRANCH already requires: $EXISTING_CHECKS"
elif [ "$CHECKS_KNOWN" = "yes" ]; then
  GATE_STATE=none
else
  GATE_STATE=unknown
  say "   could not read what $DEFAULT_BRANCH requires — neither rulesets nor classic"
  say "   protection answered, so this run will not claim either way."
fi

# ----------------------------------------------------------------------- 2. labels
step "Labels"
label() {
  if $DRY_RUN; then
    echo "   would ensure label: $1"
  else
    gh label create "$1" --force --color "$2" --description "$3" --repo "$TARGET" >/dev/null
    echo "   ensured: $1"
  fi
}
label "dependencies"           "0366d6" "Dependency updates (Dependabot)"
label "major-review-needed"    "d93f0b" "Major version bump — a human must review before merge"
label "dependabot-needs-human" "b60205" "Auto-merge could not classify this update (or the run broke)"
label "no-ci-gate"             "fbca04" "No required status check on the base branch, so nothing was auto-merged"
label "dependabot-opted-out"   "c5def5" "Classified fine, but this repo opted out of auto-merging that tier"

# ------------------------------------------------------- 3. which ecosystems is this?
step "Ecosystems"
# --security-only writes no dependabot.yml, and this whole step exists only to compose
# that file. Running it anyway would cost an API call to answer a question nothing reads —
# and, worse, its two `die`s (an unreadable file list, a truncated one) would refuse the
# enrolment for a reason that literally cannot apply: both say "the dependabot.yml would be
# wrong" about a file this run does not write. So the step is skipped and says so.
if $SECURITY_ONLY; then
  say "   not checked — --security-only writes no dependabot.yml, so nothing is composed"
  say "   from the answer. Run without the flag to see what this repo would get."
  : > "$WORK/eco.tsv"
else
# One API call for the whole file list; the classifier decides what counts.
#
# The errors here are NOT swallowed, and that is deliberate (2026-09-11). This call is
# the single input to "which ecosystems does this repo have", so a failed call and a
# truncated response both turn into "this repo has no dependencies" — a confidently
# wrong answer from the one script whose whole job is getting that answer right. The
# recursive tree endpoint truncates SILENTLY on large repos; `.truncated` is the only tell.
tree=$(gh api "repos/$TARGET/git/trees/$DEFAULT_BRANCH?recursive=1") \
  || die "could not list $TARGET's files (git/trees on $DEFAULT_BRANCH failed). Nothing was changed."
if [ "$(printf '%s' "$tree" | jq -r '.truncated')" = "true" ]; then
  die "$TARGET's file listing came back TRUNCATED, so ecosystem detection would be
       incomplete and the dependabot.yml would be wrong. Work this repo out by hand."
fi
printf '%s' "$tree" | jq -r '.tree[] | select(.type=="blob") | .path' > "$WORK/paths.txt"
python3 "$HERE/bin/lib/detect-ecosystems.py" < "$WORK/paths.txt" > "$WORK/eco.tsv" 2> "$WORK/eco-unsupported.txt"

if [ ! -s "$WORK/eco.tsv" ]; then
  say "   none found (no package.json / pyproject.toml / requirements.txt / workflows)"
else
  while IFS=$'\t' read -r eco dir; do say "   $eco  in  $dir"; done < "$WORK/eco.tsv"
fi
# A manifest this toolchain has no fragment for is a real finding, not an absence. Saying
# "nothing to keep updated" about a Go or Rust repo is how one gets enrolled with a stub
# that will never see a Dependabot PR.
if [ -s "$WORK/eco-unsupported.txt" ]; then
  say "   ⚠ found manifests with no template in this toolchain yet:"
  sed 's/^/      /' "$WORK/eco-unsupported.txt"
  say "      → those ecosystems will NOT be added to dependabot.yml. Add a fragment in"
  say "        templates/dependabot/ before relying on this repo being kept current."
fi
fi

# -------------------------------------------------- build the dependabot.yml we WANT
want_dependabot="$WORK/dependabot.yml"
: > "$want_dependabot"
if [ -s "$WORK/eco.tsv" ]; then
  cat "$TEMPLATES/dependabot/_header.yml" > "$want_dependabot"
  while IFS=$'\t' read -r eco dir; do
    frag="$TEMPLATES/dependabot/$eco.yml"
    # Loudly, not `continue`. Skipping silently produced a file that is just `updates:`
    # with no entries under it, which Dependabot rejects outright — and the PR would have
    # been opened anyway, so the breakage surfaced in the target repo, not here.
    [ -f "$frag" ] || die "the detector found ecosystem '$eco' but templates/dependabot/$eco.yml does not exist.
       Add that fragment (or teach the detector to stop reporting it) before enrolling $TARGET."
    echo >> "$want_dependabot"
    sed "s|{{DIRECTORY}}|$dir|g" "$frag" >> "$want_dependabot"
  done < "$WORK/eco.tsv"
fi

# ----------------------------------------------- 4+5. the file changes, via a branch
step "Files"

# --- dependabot.yml: write only if absent; otherwise report the difference and move on.
#     An existing file is a decision someone made. We never overwrite it.
if $SECURITY_ONLY; then
  say "   dependabot.yml: NOT written (--security-only) — no version-update PRs will be"
  say "   opened here. GitHub's account-wide security fixes still arrive; they need no file."
elif [ ! -s "$want_dependabot" ]; then
  say "   dependabot.yml: skipped — nothing to keep updated in this repo"
elif [ -n "$existing_db" ]; then
  say "   dependabot.yml: ALREADY EXISTS — leaving it exactly as it is."
  # Compare the SETTINGS, not the prose. Both files are mostly explanatory comments, and a
  # raw diff of them buries the one line that actually differs under seventy that do not.
  strip() { grep -vE '^[[:space:]]*(#|$)' "$1" > "$2" || :; }
  strip "$existing_db" "$WORK/db.a"; strip "$want_dependabot" "$WORK/db.b"
  if diff -u "$WORK/db.a" "$WORK/db.b" > "$WORK/db.diff" 2>/dev/null; then
    say "   its settings already match the template."
  else
    say "   settings that differ from the template (comments ignored):"
    say "     '-' = what this repo has today   '+' = what the template would say"
    sed -e '1,2d' -e 's/^/      /' "$WORK/db.diff"
  fi
else
  cp "$want_dependabot" "$CLONE/.github/dependabot.yml"
  FILES_PROPOSED="$FILES_PROPOSED .github/dependabot.yml(new)"
  say "   dependabot.yml: writing a new one"
fi

# --- the caller stub, which is what actually points this repo at the shared rules.
#
# ⚠ A STUB THAT ALREADY POINTS HERE IS LEFT ALONE (fixed 2026-09-11). This used to be an
# unconditional `cp`, which meant that re-running enroll over every repo — the documented
# way to roll out a change — silently reverted every per-repo exception carved into a
# `with:` block, and the PR body said only "a ten-line workflow", so the revert was
# invisible to anyone reading the body rather than the diff. A repo with `merge-minor:
# false` because a minor broke production would have had it turned back on.
#
# The trade: if the stub TEMPLATE itself ever changes (a new trigger type, say), enroll no
# longer propagates it to already-pointing repos. That is the right way round — a missed
# template refresh is visible and harmless; a reverted exception is neither. To force a
# refresh, delete the repo's stub and re-run.
stub="$CLONE/.github/workflows/dependabot-automerge.yml"
if [ -f "$stub" ] && grep -q "$STD_REPO/.github/workflows/dependabot-automerge.yml" "$stub"; then
  if grep -qE '^[[:space:]]*with:' "$stub"; then
    say "   automerge stub: LEFT ALONE — it already points at the shared rules and carries a carved exception:"
    sed -n '/^[[:space:]]*with:/,/^[[:space:]]*$/p' "$stub" | sed 's/^/        /'
  else
    say "   automerge stub: left alone — already points at the shared rules"
  fi
else
  if [ -f "$stub" ]; then
    stub_note="REPLACING an older inline copy of the merge rules"
  else
    stub_note="new"
  fi
  cp "$TEMPLATES/caller-stub.yml" "$stub"
  say "   automerge stub: $stub_note"
fi

# --- did anything actually change?
if [ -z "$(git -C "$CLONE" status --porcelain)" ]; then
  say "   no file changes needed — this repo's files are already correct."
  PR_URL="(none needed)"
else
  [ -n "$FILES_PROPOSED" ] || FILES_PROPOSED=" .github/workflows/dependabot-automerge.yml"
  git -C "$CLONE" status --porcelain | sed 's/^/      /'
  if $DRY_RUN; then
    say
    say "   would open a pull request on branch '$BRANCH_NAME' containing:"
    git -C "$CLONE" --no-pager diff -- . | sed 's/^/      /'
    git -C "$CLONE" status --porcelain | awk '$1=="??"{print $2}' | while read -r f; do
      echo "      ┄┄ new file: $f"
      sed 's/^/      + /' "$CLONE/$f"
    done
    PR_URL="(dry run — not opened)"
  else
    git -C "$CLONE" checkout -q -b "$BRANCH_NAME"
    git -C "$CLONE" add -A
    git -C "$CLONE" commit -q -m "$COMMIT_SUBJECT" -m "Points this repo at khglynn/repo-standards for the merge rules, so the policy lives
in one place instead of drifting per repo.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>"
    # NEVER a bare --force (2026-09-11). This branch is generated by this script, but an
    # open enroll PR can carry a review fix or a hand-edited exception pushed on top, and
    # --force destroys that silently. A shallow clone of the default branch has no
    # remote-tracking ref for this branch, so plain --force-with-lease cannot help either:
    # it has nothing to compare against. So we look the remote branch up explicitly, and
    # only overwrite it when its tip is a commit THIS SCRIPT wrote.
    remote_tip=$(git -C "$CLONE" ls-remote origin "refs/heads/$BRANCH_NAME" | awk '{print $1}')
    if [ -n "$remote_tip" ]; then
      git -C "$CLONE" fetch -q --depth 1 origin "$BRANCH_NAME"
      remote_subject=$(git -C "$CLONE" log -1 --format=%s "$remote_tip" 2>/dev/null || echo "<unreadable>")
      if [ "$remote_subject" != "$COMMIT_SUBJECT" ]; then
        die "'$BRANCH_NAME' already exists on $TARGET and its tip is not one of mine:
         \"$remote_subject\"
       Someone has pushed to that branch. Look at it, then merge or delete it before
       re-running. Nothing on $TARGET was changed."
      fi
      # Lease against the exact SHA we just read: if anything lands between this line and
      # the push, the push is refused instead of overwriting it.
      git -C "$CLONE" push -q --force-with-lease="$BRANCH_NAME:$remote_tip" -u origin "$BRANCH_NAME"
    else
      git -C "$CLONE" push -q -u origin "$BRANCH_NAME"
    fi

    # THE BODY IS GENERATED FOR BOTH PATHS, not only when the PR is created.
    # Re-running enroll with different flags over an open enroll PR used to replace the
    # BRANCH and leave the old description standing — so a repo re-run with --security-only
    # would carry a pull request still promising weekly version updates, and the promise is
    # the only place that decision is visible, since it is a file's ABSENCE (Codex review,
    # 2026-09-14).
    body_file="$WORK/pr-body.md"
    {
      echo "Enrolls this repo in the shared Dependabot standards at [khglynn/repo-standards](https://github.com/$STD_REPO)."
      echo
      if $SECURITY_ONLY; then
        # The body has to say the quiet part, because the diff cannot: what is MISSING
        # from this PR (a dependabot.yml) is the whole decision being made.
        echo "**What changes:** one ten-line workflow that points at the shared merge rules. Deliberately **no \`dependabot.yml\`** — this repo is enrolled for security fixes only."
        echo
        echo "**What it means day to day:** no routine \"there is a newer version\" pull requests will be opened here. GitHub's account-wide Dependabot *security* fixes still arrive — those need no file in any repo. A major-version security fix gets a \`major-review-needed\` label and waits for you."
        echo
        case "$GATE_STATE" in
          new)         echo "**The check they wait for:** \`$REQUIRED_CHECK\`, which this run makes a required check on \`$DEFAULT_BRANCH\`. Security fixes approve and merge themselves once it is green." ;;
          preexisting) echo "**The check they wait for:** \`$EXISTING_CHECKS\` — already required on \`$DEFAULT_BRANCH\` before this run. Security fixes approve and merge themselves once it is green." ;;
          none)        echo "**Nothing will merge by itself:** \`$DEFAULT_BRANCH\` has no required status check, so every security PR gets a \`no-ci-gate\` label and waits for you." ;;
          *)           echo "**Whether anything merges by itself is unknown:** this run could not read what \`$DEFAULT_BRANCH\` requires. If it requires a check, security fixes will merge once that check is green; if it requires none, they will wait for you with a \`no-ci-gate\` label." ;;
        esac
      else
        echo "**What changes:** a \`dependabot.yml\` (only if the repo had none) asking Dependabot for weekly updates, plus a ten-line workflow that points at the shared merge rules."
        echo
        echo "**What it means day to day:** patch and minor dependency updates approve and merge themselves once CI is green. Major bumps get a \`major-review-needed\` label and wait for you. If the branch has no required CI check, nothing merges automatically at all — the PR gets a \`no-ci-gate\` label explaining why."
      fi
      echo
      echo "**To undo it:** delete \`.github/workflows/dependabot-automerge.yml\`."
    } > "$body_file"

    existing_pr=$(gh pr list --repo "$TARGET" --head "$BRANCH_NAME" --state open --json url --jq '.[0].url' 2>/dev/null || true)
    if [ -n "$existing_pr" ]; then
      PR_URL="$existing_pr"
      if gh pr edit "$PR_URL" --body-file "$body_file" >/dev/null 2>&1; then
        say "   pull request already open, updated it and its description: $PR_URL"
      else
        say "   pull request already open, branch updated: $PR_URL"
        say "   ⚠ could not rewrite its description, so it may still describe the PREVIOUS"
        say "     enrolment shape. Read it before merging."
      fi
    else
      if PR_URL=$(gh pr create --repo "$TARGET" --base "$DEFAULT_BRANCH" --head "$BRANCH_NAME" \
            --title "standards: enroll in shared Dependabot auto-merge" --body-file "$body_file" 2>&1); then
        say "   pull request: $PR_URL"
      else
        say "   could not open the PR automatically ($PR_URL). The branch IS pushed; run:"
        say "      gh pr create --repo $TARGET --base $DEFAULT_BRANCH --head $BRANCH_NAME --fill"
        PR_URL="(branch pushed, PR not opened)"
      fi
    fi
  fi
fi

# ------------------------------------------------------------- 6. allow auto-merge
step "Repo setting: allow auto-merge"
if [ "$AUTO_MERGE_ALREADY" = "true" ]; then
  say "   already on"
elif $DRY_RUN; then
  say "   would turn it on (gh api -X PATCH repos/$TARGET -F allow_auto_merge=true)"
else
  gh api -X PATCH "repos/$TARGET" -F allow_auto_merge=true --silent
  say "   turned on"
fi

# ------------------------------------- 6b. let the workflow's token approve the PR
# The shared workflow approves a safe bump before enabling auto-merge, so repos with a
# "one approving review" rule still merge. That approval is refused unless the repo's
# Actions setting "Allow GitHub Actions to create and approve pull requests" is on
# (Settings → Actions → General → Workflow permissions). Only that switch is written; the
# default token permissions are left as they are. Found 2026-09-14: three freshly
# enrolled repos had it off, the approve call failed, and the PRs sat queued for auto-merge
# behind a review that could never arrive. Default workflow permissions stay read-only.
step "Repo setting: Actions may approve pull requests"
CAN_APPROVE=$(gh api "repos/$TARGET/actions/permissions/workflow" --jq '.can_approve_pull_request_reviews' 2>/dev/null || echo unknown)
if [ "$CAN_APPROVE" = "true" ]; then
  say "   already on"
elif $DRY_RUN; then
  say "   would turn it on (gh api -X PUT repos/$TARGET/actions/permissions/workflow -F can_approve_pull_request_reviews=true)"
else
  # Only the approve switch. Sending default_workflow_permissions too would silently
  # downgrade a repo whose workflows rely on the write default (Codex review, 2026-09-14).
  gh api -X PUT "repos/$TARGET/actions/permissions/workflow" -F can_approve_pull_request_reviews=true --silent
  say "   turned on"
fi

# ------------------------------------------------------------------ 7. the CI gate
step "CI gate (ruleset 'standards-ci')"
if [ -z "$REQUIRED_CHECK" ]; then
  say "   skipped — no --ci-check given."
  say "   Without a required status check on $DEFAULT_BRANCH the shared workflow will"
  say "   deliberately refuse to auto-merge, and label PRs 'no-ci-gate' instead."
else
  # Repository admins bypass ALWAYS. A required-status-checks rule also blocks direct
  # pushes to the branch, and Kevin pushes straight to main in several repos — this is
  # what keeps him unblocked while the bot (github-actions, not an admin) still has to
  # satisfy the check. actor_id 5 / RepositoryRole is the built-in repository-admin role.
  #
  # NO `integration_id` ON THE REQUIRED CHECK, deliberately. GitHub lets a required check
  # name the app that must report it, which would stop any other app satisfying the name.
  # Pinning it needs that app's numeric id, looked up per vendor (Vercel, Cloudflare,
  # Netlify…) and re-looked-up whenever one changes — a lookup table this tool would have
  # to carry and keep true. Left off, ANY app that reports the context satisfies the gate.
  # The exposure is narrow: an attacker would already need write access to install an app
  # in Kevin's repo, at which point the gate is not what is protecting him. Revisit if an
  # external check is ever the only thing standing between a bot and production.
  ruleset_body=$(jq -n --arg check "$REQUIRED_CHECK" '{
    name: "standards-ci",
    target: "branch",
    enforcement: "active",
    conditions: { ref_name: { include: ["~DEFAULT_BRANCH"], exclude: [] } },
    bypass_actors: [ { actor_id: 5, actor_type: "RepositoryRole", bypass_mode: "always" } ],
    rules: [ {
      type: "required_status_checks",
      parameters: {
        strict_required_status_checks_policy: false,
        do_not_enforce_on_create: false,
        required_status_checks: [ { context: $check } ]
      }
    } ]
  }')
  existing_id=$(gh api "repos/$TARGET/rulesets" --jq '.[] | select(.name=="standards-ci") | .id' 2>/dev/null | head -1 || true)
  if $DRY_RUN; then
    if [ -n "$existing_id" ]; then
      say "   would UPDATE existing ruleset id $existing_id"
    else
      say "   would CREATE ruleset 'standards-ci'"
    fi
    say "   requiring check '$REQUIRED_CHECK' on $DEFAULT_BRANCH, repository admins bypass always"
  elif [ -n "$existing_id" ]; then
    printf '%s' "$ruleset_body" | gh api -X PUT "repos/$TARGET/rulesets/$existing_id" --input - --silent
    say "   updated ruleset $existing_id: '$REQUIRED_CHECK' required on $DEFAULT_BRANCH"
  else
    printf '%s' "$ruleset_body" | gh api -X POST "repos/$TARGET/rulesets" --input - --silent
    say "   created ruleset 'standards-ci': '$REQUIRED_CHECK' required on $DEFAULT_BRANCH"
  fi
fi

# ----------------------------------------------------------------------- summary
if $DRY_RUN; then outcome="dry run — nothing changed"; else outcome="done"; fi
echo
echo "════════════════════════════════════════════════════════════════════"
echo " $TARGET — $outcome"
echo "════════════════════════════════════════════════════════════════════"
if $SECURITY_ONLY; then
  echo " Ecosystems found: not checked (--security-only writes no dependabot.yml)"
else
  echo " Ecosystems found:$(if [ -s "$WORK/eco.tsv" ]; then awk -F'\t' '{printf " %s(%s)", $1, $2}' "$WORK/eco.tsv"; else echo ' none'; fi)"
fi
echo " Files proposed:${FILES_PROPOSED:- none}"
echo " Pull request: ${PR_URL:-none}"
case "$GATE_STATE" in
  new)
    if [ "$CHECK_KIND" = "external" ]; then
      echo " CI gate: '$REQUIRED_CHECK' required on $DEFAULT_BRANCH — reported by another service,"
      echo "          not by a workflow here (you can still push directly)"
    else
      echo " CI gate: '$REQUIRED_CHECK' required on $DEFAULT_BRANCH (you can still push directly)"
    fi ;;
  # No flag was given, but the branch already has a gate — so things WILL merge by
  # themselves here, and a summary saying "NONE" would have been a flat lie.
  preexisting)
    echo " CI gate: none was given, but $DEFAULT_BRANCH already requires '$EXISTING_CHECKS',"
    echo "          so updates will merge themselves once that is green." ;;
  none)
    echo " CI gate: NONE. Nothing will auto-merge here until this repo has one." ;;
  *)
    echo " CI gate: UNKNOWN — this run could not read what $DEFAULT_BRANCH requires, so it"
    echo "          will not claim either way. Check the branch's rules before relying on it." ;;
esac
# The one sentence this run exists to make true, said in the summary as well as the PR
# body: a security-only enrolment is a decision about what will NOT arrive, and a summary
# that only lists what was written describes it by omission.
if $SECURITY_ONLY; then
  echo
  echo " SECURITY FIXES ONLY. No dependabot.yml was written, so Dependabot will open no"
  echo " routine version-update pull requests here. GitHub's account-wide security fixes"
  case "$GATE_STATE" in
    new)         echo " still arrive, and those are what will approve and merge themselves once"
                 echo " '$REQUIRED_CHECK' is green. Nothing else merges by itself." ;;
    preexisting) echo " still arrive, and those will approve and merge themselves once this branch's"
                 echo " existing check ('$EXISTING_CHECKS') is green. Nothing else merges by itself." ;;
    none)        echo " still arrive — and with no required check, every one of them waits for you." ;;
    *)           echo " still arrive. Whether they merge by themselves is UNKNOWN: this run could not"
                 echo " read what $DEFAULT_BRANCH requires, so it will not promise either way." ;;
  esac
fi
echo
if $DRY_RUN; then
  echo " YOUR MOVE: nothing — this was a dry run. Re-run without --dry-run to do it."
else
  echo " YOUR MOVE: review and merge the pull request above. Nothing takes effect until"
  echo " it lands on $DEFAULT_BRANCH — GitHub only runs a workflow that is already on"
  echo " the default branch."
fi
