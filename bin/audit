#!/usr/bin/env bash
# audit — one read-only picture of where every repo stands.
#
#   bin/audit [--owner khglynn] [--json | --digest] [--cap 300] [--skip-actions]
#
#   (no flag)       the markdown table: one row per repo, one status word at the end
#   --digest        the weekly Slack block, in plain English, for a person
#   --json          every field as structured data, for anything downstream
#   --cap N         how many runs per repo to measure for the minutes estimate (default 300)
#   --skip-actions  no Actions calls at all: no approve column, no minutes, no warnings.
#                   Much faster when all you want is the enrolment picture. Every output
#                   then says those things were NOT MEASURED rather than reporting zero.
#
# Reads nothing but the GitHub API and writes nothing anywhere. Safe to run any time,
# from any machine. Written 2026-09-11; Actions columns and the digest added 2026-09-14
# (spec: khglynn/repo-standards#1).
#
# ONE COST TO KNOW ABOUT: a full run costs roughly 1,600 API calls, a third of GitHub's
# hourly 5,000, almost all of it measuring Actions minutes. Weekly is free; iterating on
# it three times in an hour is not, and the fourth run will find the budget gone. Use
# `--skip-actions` while you are working on anything else, or `--cap 50` to sample. When
# the budget IS short the run falls back to a cheaper, lower-reading measurement and says
# so in its output rather than silently producing a smaller number.
#
# The status column is the thing to read:
#   enrolled       — dependabot.yml + the pointer stub + auto-merge on + a required check
#                    + the approve switch. Routine updates land by themselves here.
#   security-only  — no version-update config. Still covered by account-wide Dependabot
#                    security alerts and fixes; just not kept current for its own sake.
#                    A perfectly fine state for a repo nobody deploys.
#   drift: …       — half-enrolled, and the reason says which half. This is the column
#                    that makes drift impossible to not notice.
#
# The two WARNING sections under the table are not drift and nothing about them is
# broken — a job with no time limit and a workflow that runs twice per commit both just
# cost minutes, and the second one is sometimes deliberate.

set -euo pipefail

OWNER="khglynn"
MODE="table"
CAP=300
SKIP_ACTIONS=no
STD_PATH="khglynn/repo-standards/.github/workflows/dependabot-automerge.yml"

while [ $# -gt 0 ]; do
  case "$1" in
    --owner) OWNER="${2:-}"; shift 2 ;;
    --json) MODE="json"; shift ;;
    --digest) MODE="digest"; shift ;;
    --cap) CAP="${2:-300}"; shift 2 ;;
    --skip-actions) SKIP_ACTIONS=yes; shift ;;
    -h|--help) sed -n '2,36p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown option: $1" >&2; exit 1 ;;
  esac
done
for t in gh jq python3; do command -v "$t" >/dev/null || { echo "missing tool: $t" >&2; exit 1; }; done

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SINCE="$(date +%Y-%m-01)"

# Is the tree response readable and complete? Prints "false" (not truncated — good),
# "true" (truncated), or "err" (no answer at all).
#
# THIS LINE USED TO BE `.truncated // "err"` AND IT WAS WRONG IN THE WORST WAY. jq's `//`
# treats **false** as empty, exactly like null — so a perfectly good tree whose
# `"truncated": false` is the answer we want came back "err", and EVERY repo read
# `unknown: could not read this repo's file list`. The status column, which is the whole
# point of this tool, said nothing true from 2026-09-11 (commit cd917d9, a review fix for
# the opposite failure) until 2026-09-14. It printed a full, confident table the entire
# time. bin/lib/check-audit.sh now pins all three cases; the program lives on one line so
# that test can extract and run the real thing rather than a retyped copy of it.
TREE_STATE_JQ='if type=="object" and has("truncated") then (.truncated|tostring) else "err" end'

# Same trap, same shape, and it bit again inside the hour: the approve switch is a
# BOOLEAN, and `.approve // "?"` turns a perfectly good **false** into "?" — which is the
# one value the drift rule below is looking for. The column would have read "?" and the
# drift would never have fired, on exactly the repos the column was added to catch.
# Any jq default over a field that can legitimately be `false` has to be written this way.
APPROVE_JQ='if has("approve") and .approve != null then (.approve|tostring) else "?" end'

# Preflight. An exhausted API budget does not make this tool fail — it makes it print a
# full, confident, entirely empty report, every repo reading "could not read this repo's
# file list". That happened on 2026-09-14. One call spent here is worth fifteen hundred
# spent producing a lie. (And it reads the budget from a real call's headers: the
# /rate_limit endpoint said 5,000 remaining while every call was being refused.)
if pf=$(python3 "$HERE/bin/lib/actions-scan.py" --owner "$OWNER" --preflight 2>/dev/null); then
  :
else
  case "$pf" in
    exhausted*)
      read -r _ left when <<< "$pf"
      echo "GitHub's hourly API budget is used up (${left:-0} calls left). This audit needs" >&2
      echo "about 1,600. Come back after ${when:-the reset} and run it again." >&2
      exit 2 ;;
  esac
fi

echo "Reading $OWNER's repos…" >&2

repos=$(gh repo list "$OWNER" --limit 300 --no-archived \
          --json name,visibility,pushedAt,defaultBranchRef,isFork \
          --jq '.[] | [.name, .visibility, .pushedAt, (.defaultBranchRef.name // ""), (.isFork|tostring)] | @tsv')

# One search for every open Dependabot PR the account has, rather than one call per repo.
dependabot_prs=$(gh api -X GET search/issues \
  -f q="is:pr is:open author:app/dependabot user:$OWNER" --paginate \
  --jq '.items[] | [(.repository_url|split("/")|last), .created_at] | @tsv' 2>/dev/null || true)

TMP=$(mktemp -d); trap 'rm -rf "$TMP"' EXIT
printf '%s\n' "$dependabot_prs" > "$TMP/prs.tsv"

# --- the Actions pass: approve switch, minutes this billing month, workflow hygiene.
# It runs ONCE for every repo, concurrently, before the loop below — one `/timing` call
# per run and the account does ~1,300 runs a month, which inside a serial bash loop is
# twenty minutes. See bin/lib/actions-scan.py for why the minutes are wall-clock and why
# the billing endpoints are not called.
echo '{"repos":{}}' > "$TMP/scan.json"
if [ "$SKIP_ACTIONS" = "no" ]; then
  echo "Measuring Actions usage since $SINCE (this is the slow part)…" >&2
  printf '%s\n' "$repos" | awk -F'\t' 'NF{print $1"\t"$4"\t"$2}' \
    | python3 "$HERE/bin/lib/actions-scan.py" --owner "$OWNER" --since "$SINCE" \
        --cap "$CAP" --progress > "$TMP/scan.json" || {
      echo "actions scan failed; continuing without those columns" >&2
      echo '{"repos":{}}' > "$TMP/scan.json"
    }
fi

: > "$TMP/rows.jsonl"

while IFS=$'\t' read -r name visibility pushed_at default_branch is_fork; do
  [ -n "$name" ] || continue
  R="$OWNER/$name"
  printf '  %-55s\r' "$R" >&2

  scan=$(jq -c --arg n "$name" '.repos[$n] // {}' "$TMP/scan.json")
  approve=$(jq -r "$APPROVE_JQ" <<< "$scan")

  # --- the repo's own settings
  auto_merge=$(gh api "repos/$R" --jq '.allow_auto_merge' 2>/dev/null || echo "?")

  # --- the file list (one call), which answers three questions at once
  # A failed or TRUNCATED listing would otherwise look identical to "this repo has no
  # files", and the row would quietly read security-only. audit is read-only so it does
  # not stop the world for one repo — it marks the row instead. (2026-09-11)
  tree=$(gh api "repos/$R/git/trees/$default_branch?recursive=1" 2>/dev/null || true)
  paths=$(printf '%s' "$tree" | jq -r '.tree[]? | select(.type=="blob") | .path' 2>/dev/null || true)
  unreadable=no
  if [ -z "$tree" ] || [ "$(printf '%s' "$tree" | jq -r "$TREE_STATE_JQ" 2>/dev/null)" != "false" ]; then
    unreadable=yes
  fi
  # Here-strings, not pipes: `grep -q` exits on its first match, and a pipe feeding it then
  # takes SIGPIPE and prints "write error: Broken pipe" for a search that actually succeeded.
  has_manifest=no
  # GitHub Actions are dependencies too — a repo with workflows and no app manifest still has
  # something Dependabot can keep current, so it counts here.
  # This list is the UNION of bin/lib/detect-ecosystems.py's MANIFESTS and UNSUPPORTED.
  # Keep the two in step: a file that counts as a manifest here but has no template there
  # is a repo that audits as enrollable and then can't be enrolled — `enroll` now says so
  # out loud rather than reporting "nothing to keep updated" (2026-09-11).
  if grep -qE '(^|/)(package\.json|requirements\.txt|pyproject\.toml|go\.mod|Gemfile|Cargo\.toml|composer\.json|pom\.xml|build\.gradle)$|^\.github/workflows/.*\.ya?ml$' <<< "$paths"; then
    has_manifest=yes
  fi
  has_dependabot=no
  if grep -qE '^\.github/dependabot\.ya?ml$' <<< "$paths"; then has_dependabot=yes; fi

  # A repo is "stubbed" when ANY of its workflows calls the shared rules. The standards repo
  # itself holds the DEFINITION at the obvious path, so its own stub has a different name —
  # check both, and recognise the definition rather than mistaking it for a stale inline copy.
  has_stub=no
  for cand in .github/workflows/dependabot-automerge.yml .github/workflows/dependabot-automerge-self.yml; do
    grep -qF "$cand" <<< "$paths" || continue
    content=$(gh api "repos/$R/contents/$cand" --jq '.content' 2>/dev/null | base64 -d 2>/dev/null || true)
    if grep -qF "$STD_PATH" <<< "$content"; then has_stub=yes; break; fi
    if grep -q 'workflow_call:' <<< "$content"; then has_stub=source; break; fi
    has_stub=inline   # an older, per-repo copy of the rules — the thing we are replacing
  done

  # --- required status checks on the default branch: rulesets first, classic as fallback
  checks=$(gh api "repos/$R/rules/branches/${default_branch//\//%2F}" 2>/dev/null \
            | jq -r '[.[] | select(.type=="required_status_checks")
                          | .parameters.required_status_checks[]?.context] | unique | join(", ")' 2>/dev/null || true)
  if [ -z "$checks" ]; then
    checks=$(gh api "repos/$R/branches/${default_branch//\//%2F}/protection" 2>/dev/null \
              | jq -r '(((.required_status_checks.checks // []) | map(.context))
                        + (.required_status_checks.contexts // [])) | unique | join(", ")' 2>/dev/null || true)
  fi
  [ -n "$checks" ] || checks="—"

  # --- open Dependabot pull requests, and how long the oldest has been sitting there
  pr_count=$(awk -F'\t' -v r="$name" '$1==r' "$TMP/prs.tsv" | wc -l | tr -d ' ')
  pr_cell="0"; pr_age="null"
  if [ "$pr_count" -gt 0 ]; then
    oldest=$(awk -F'\t' -v r="$name" '$1==r {print $2}' "$TMP/prs.tsv" | sort | head -1)
    pr_age=$(python3 -c "
import datetime,sys
d=datetime.datetime.strptime(sys.argv[1],'%Y-%m-%dT%H:%M:%SZ').replace(tzinfo=datetime.timezone.utc)
print((datetime.datetime.now(datetime.timezone.utc)-d).days)" "$oldest")
    pr_cell="$pr_count (oldest ${pr_age}d)"
  fi

  # --- the verdict
  # A fork's dependabot.yml belongs to whoever we forked FROM. Enrolling one means fighting
  # upstream on every sync, so a fork is never drift — it is just not ours to standardise.
  if [ "$unreadable" = "yes" ]; then
    status="unknown: could not read this repo's file list (API error or truncated tree)"
  elif [ "$is_fork" = "true" ]; then
    status="fork — upstream's config, leave it alone"
  elif { [ "$has_stub" = "yes" ] || [ "$has_stub" = "source" ]; } && [ "$approve" = "false" ]; then
    # The switch whose absence stranded three list-maker PRs on 2026-09-14: the shared
    # workflow's `gh pr review --approve` is refused outright, so in any repo with a
    # one-approval rule the PR queues behind a review that can never arrive.
    status="drift: Actions may not approve pull requests here, so the workflow's approvals will be refused"
  elif [ "$has_stub" = "source" ] && [ "$has_dependabot" = "yes" ]; then
    status="enrolled (this repo IS the standard)"
  elif [ "$has_stub" = "inline" ]; then
    status="drift: still has its own private copy of the merge rules"
  elif [ "$has_dependabot" = "no" ] && [ "$has_stub" = "no" ]; then
    if [ "$has_manifest" = "yes" ]; then
      status="security-only"
    else
      status="security-only (nothing to update)"
    fi
  elif [ "$has_dependabot" = "yes" ] && [ "$has_stub" = "no" ]; then
    status="drift: gets update PRs but nothing merges them"
  elif [ "$has_stub" = "yes" ] && [ "$has_dependabot" = "no" ]; then
    status="drift: merge rules but no dependabot.yml, so no update PRs"
  elif [ "$auto_merge" != "true" ]; then
    status="drift: repo setting 'allow auto-merge' is off"
  elif [ "$checks" = "—" ]; then
    status="drift: no required check, so nothing can safely auto-merge"
  else
    status="enrolled"
  fi

  pushed_day=${pushed_at%%T*}
  jq -nc --arg name "$name" --arg visibility "$visibility" --arg pushed "$pushed_day" \
        --arg manifest "$has_manifest" --arg dependabot "$has_dependabot" \
        --arg stub "$has_stub" --arg auto_merge "$auto_merge" --arg checks "$checks" \
        --arg prs "$pr_cell" --argjson pr_count "$pr_count" --argjson pr_oldest_days "$pr_age" \
        --arg approve_cell "$approve" --arg status "$status" --arg is_fork "$is_fork" \
        --argjson scan "$scan" \
    '{name:$name, visibility:$visibility, pushed:$pushed, manifest:$manifest,
      dependabot:$dependabot, stub:$stub, auto_merge:$auto_merge, checks:$checks,
      prs:$prs, pr_count:$pr_count, pr_oldest_days:$pr_oldest_days,
      approve:(if ($scan|has("approve")) then $scan.approve else null end),
      approve_cell:$approve_cell,
      minutes:($scan.minutes // null), runs:($scan.runs // null),
      timed:($scan.timed // null), capped:($scan.capped // false),
      runners:($scan.runners // []),
      missing_timeout:($scan.missing_timeout // []),
      double_trigger:($scan.double_trigger // []),
      unparsed:($scan.unparsed // []), parser:($scan.parser // null),
      errors:($scan.errors // []),
      is_fork:($is_fork=="true"), status:$status}' >> "$TMP/rows.jsonl"
done <<< "$repos"

printf '                                             \r' >&2

# How the minutes were measured — and, when they were not, WHICH kind of not. The
# renderer refuses to print a figure for "skipped" or "none", because the alternative is
# what `--digest --skip-actions` printed on 2026-09-14: "about 0 minutes of the free 3,000
# … the month ends near 0, inside the free pool", about a measurement it never took. A
# skipped measurement has to read as not measured, never as good news.
if [ "$SKIP_ACTIONS" = "yes" ]; then
  method="skipped"
else
  method=$(jq -r '.method // "none"' "$TMP/scan.json")
fi
note=$(jq -r '.note // ""' "$TMP/scan.json")

python3 "$HERE/bin/lib/render-audit.py" --mode "$MODE" --owner "$OWNER" \
        --since "$SINCE" --cap "$CAP" --method "$method" --note "$note" < "$TMP/rows.jsonl"
